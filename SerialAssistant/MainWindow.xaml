<Window
    x:Class="SerialAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SerialAssistant.ViewModels"
    Title="串口调试助手"
    Width="800"
    Height="760"
    MinWidth="900"
    MinHeight="600"
    d:DesignHeight="760"
    d:DesignWidth="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="#FF3C4653" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="#FF2C6FBB"
                            CornerRadius="3"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3A82D2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF245A99" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#FFBFC5CC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ==================== 串口设置 ====================  -->
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,8"
            Padding="10,8"
            Header="串口设置">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  第一行：端口 + 刷新 + 预设  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ParamLabel}" Text="端口" />
                    <ComboBox
                        Width="320"
                        Height="26"
                        DisplayMemberPath="Display"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding Ports}"
                        SelectedItem="{Binding SelectedPort}"
                        ToolTip="{Binding SelectedPort.Display}" />
                    <Button
                        Width="56"
                        Height="26"
                        Margin="6,0,0,0"
                        Command="{Binding RefreshPortsCommand}"
                        Content="刷新"
                        IsEnabled="{Binding CanEditSettings}"
                        ToolTip="重新搜索当前系统的串口" />

                    <TextBlock
                        Margin="20,0,6,0"
                        Style="{StaticResource ParamLabel}"
                        Text="预设" />
                    <ComboBox
                        Width="170"
                        Height="26"
                        DisplayMemberPath="Name"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding Presets}"
                        SelectedItem="{Binding SelectedPreset}"
                        ToolTip="一键套用常用串口参数组合" />
                </StackPanel>

                <!--  第二行：参数 + 打开串口  -->
                <DockPanel Grid.Row="1" LastChildFill="False">
                    <Button
                        Width="112"
                        Height="28"
                        Command="{Binding ToggleOpenCommand}"
                        Content="{Binding OpenButtonText}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource AccentButton}" />

                    <TextBlock Style="{StaticResource ParamLabel}" Text="波特率" />
                    <ComboBox
                        Width="92"
                        Height="26"
                        IsEditable="True"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding BaudRates}"
                        Text="{Binding SelectedBaudRate, UpdateSourceTrigger=LostFocus}"
                        ToolTip="可直接输入非标准波特率" />

                    <TextBlock
                        Margin="14,0,6,0"
                        Style="{StaticResource ParamLabel}"
                        Text="数据位" />
                    <ComboBox
                        Width="62"
                        Height="26"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding DataBitsOptions}"
                        SelectedItem="{Binding SelectedDataBits}" />

                    <TextBlock
                        Margin="14,0,6,0"
                        Style="{StaticResource ParamLabel}"
                        Text="校验" />
                    <ComboBox
                        Width="88"
                        Height="26"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding ParityOptions}"
                        SelectedItem="{Binding SelectedParity}" />

                    <TextBlock
                        Margin="14,0,6,0"
                        Style="{StaticResource ParamLabel}"
                        Text="停止位" />
                    <ComboBox
                        Width="68"
                        Height="26"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding StopBitsOptions}"
                        SelectedItem="{Binding SelectedStopBits}" />

                    <TextBlock
                        Margin="14,0,6,0"
                        Style="{StaticResource ParamLabel}"
                        Text="流控" />
                    <ComboBox
                        Width="150"
                        Height="26"
                        IsEnabled="{Binding CanEditSettings}"
                        ItemsSource="{Binding HandshakeOptions}"
                        SelectedItem="{Binding SelectedHandshake}" />
                </DockPanel>
            </Grid>
        </GroupBox>

        <!--  ==================== 接收区 ====================  -->
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,8"
            Padding="10,8"
            Header="接收区">
            <DockPanel>
                <StackPanel
                    Margin="0,0,0,6"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <CheckBox
                        VerticalAlignment="Center"
                        Content="HEX 显示"
                        IsChecked="{Binding IsDisplayHex}" />
                    <CheckBox
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="时间戳"
                        IsChecked="{Binding ShowTimestamp}" />
                    <CheckBox
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="自动滚动"
                        IsChecked="{Binding AutoScroll}" />

                    <Button
                        Width="60"
                        Height="24"
                        Margin="20,0,0,0"
                        Command="{Binding ClearDisplayCommand}"
                        Content="清空" />

                    <CheckBox
                        Margin="20,0,0,0"
                        VerticalAlignment="Center"
                        Content="记录日志"
                        IsChecked="{Binding IsLogging}"
                        ToolTip="勾选后实时把收发内容写入日志文件" />

                    <TextBlock
                        MaxWidth="380"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Foreground="#FF8A93A0"
                        Text="{Binding LogFilePath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding LogFilePath}"
                        Visibility="{Binding IsLogging, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <TextBox
                    x:Name="ReceiveBox"
                    AcceptsReturn="True"
                    Background="#FFFBFCFD"
                    FontFamily="Consolas"
                    FontSize="13"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    TextChanged="OnReceiveTextChanged"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </GroupBox>

        <!--  ==================== 发送区 ====================  -->
        <GroupBox
            Grid.Row="2"
            Margin="0,0,0,8"
            Padding="10,8"
            Header="发送">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,6"
                        Orientation="Horizontal">
                        <CheckBox
                            VerticalAlignment="Center"
                            Content="HEX 发送"
                            IsChecked="{Binding IsSendHex}">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTimedSend}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                        <CheckBox
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Content="定时发送"
                            IsChecked="{Binding IsTimedSend}"
                            IsEnabled="{Binding IsConnected}" />
                        <TextBlock
                            Margin="16,0,6,0"
                            VerticalAlignment="Center"
                            Text="间隔" />
                        <TextBox
                            Width="70"
                            IsEnabled="{Binding IsConnected}"
                            Text="{Binding IntervalMs, UpdateSourceTrigger=LostFocus}"
                            ToolTip="单位：毫秒，最小 10" />
                        <TextBlock
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Text="ms" />
                        <TextBlock
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#FF8A93A0"
                            Text="Ctrl+Enter 快速发送" />
                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Height="70"
                        AcceptsReturn="True"
                        FontFamily="Consolas"
                        FontSize="13"
                        IsEnabled="{Binding IsConnected}"
                        Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto">
                        <TextBox.InputBindings>
                            <KeyBinding
                                Key="Enter"
                                Command="{Binding SendCommand}"
                                Modifiers="Control" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <StackPanel
                        Grid.Row="2"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="64"
                            Height="28"
                            Command="{Binding ClearSendCommand}"
                            Content="清空" />
                        <Button
                            Width="104"
                            Height="28"
                            Margin="8,0,0,0"
                            Command="{Binding SendCommand}"
                            Content="发送"
                            Style="{StaticResource AccentButton}" />
                    </StackPanel>
                </Grid>

                <!--  快捷指令  -->
                <DockPanel
                    Grid.Column="1"
                    Width="230"
                    Margin="14,0,0,0">
                    <StackPanel
                        Margin="0,0,0,4"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="#FF3C4653"
                            Text="快捷指令"
                            ToolTip="双击列表项即可发送；＋ 把发送框内容存为快捷指令" />
                        <Button
                            Width="24"
                            Height="22"
                            Margin="8,0,0,0"
                            Padding="0"
                            Command="{Binding SaveQuickCommandCommand}"
                            Content="＋"
                            ToolTip="把发送框内容存为快捷指令" />
                        <Button
                            Width="24"
                            Height="22"
                            Margin="4,0,0,0"
                            Padding="0"
                            Command="{Binding RemoveQuickCommandCommand}"
                            CommandParameter="{Binding SelectedItem, ElementName=QuickList}"
                            Content="－"
                            ToolTip="删除选中的快捷指令" />
                    </StackPanel>

                    <ListBox
                        x:Name="QuickList"
                        ItemsSource="{Binding QuickCommands}"
                        MouseDoubleClick="OnQuickCommandDoubleClick"
                        ToolTip="双击某条指令立即发送" />
                </DockPanel>
            </Grid>
        </GroupBox>

        <!--  ==================== 状态栏 ====================  -->
        <Border
            Grid.Row="3"
            Padding="10,6"
            Background="#FFF3F5F7"
            BorderBrush="#FFDDE2E8"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock
                    MaxWidth="560"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Foreground="#FF5A6470"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding StatusMessage}" />

                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FFB4BAC2" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static vm:SerialConnectionState.Connected}">
                                        <Setter Property="Fill" Value="#FF3AA655" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="{x:Static vm:SerialConnectionState.Lost}">
                                        <Setter Property="Fill" Value="#FFD9534F" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <TextBlock
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding ConnectionText}" />

                    <TextBlock
                        Margin="14,0"
                        VerticalAlignment="Center"
                        Foreground="#FFC8CDD4"
                        Text="│" />
                    <TextBlock VerticalAlignment="Center" Text="发送" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding TxCount, StringFormat={}{0:N0}}" />
                    <TextBlock
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Text="字节" />

                    <TextBlock
                        Margin="14,0"
                        VerticalAlignment="Center"
                        Foreground="#FFC8CDD4"
                        Text="│" />
                    <TextBlock VerticalAlignment="Center" Text="接收" />
                    <TextBlock
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding RxCount, StringFormat={}{0:N0}}" />
                    <TextBlock
                        Margin="2,0,0,0"
                        VerticalAlignment="Center"
                        Text="字节" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

